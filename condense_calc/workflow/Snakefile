# condense-seq: paired-end reads -> condensability tables (GEO GSE252941 format) and QC.
# Usually started by `condense` (see README), which writes the config; it can also be run directly:
#   snakemake -s condense_calc/workflow/Snakefile --configfile config.yaml --directory OUTDIR --cores 8
# Relative paths in the config are read relative to the config file's folder.
import re
from pathlib import Path

import pandas as pd

PKG_PARENT = Path(workflow.basedir).parents[1]
CFG_DIR = Path(workflow.configfiles[0]).parent.resolve()


def P(p):
    p = Path(str(p)).expanduser()
    return str(p if p.is_absolute() else (CFG_DIR / p).resolve())


shell.prefix(f'export PYTHONPATH={PKG_PARENT}:$PYTHONPATH; set -euo pipefail; ')
CLI = 'python -m condense_calc'

# ---------------------------------------------------------------- settings
# Defaults and the Park preset (`park: true`) are in condense_calc/settings.py; unknown keys are an error.
import sys
sys.path.insert(0, str(PKG_PARENT))
from condense_calc import reference, settings, sheet

SETTINGS = settings.resolve(config)
TRIM = SETTINGS['trim_to']
THREADS = SETTINGS['threads']
BINS = [int(b) for b in SETTINGS['bin_sizes']]
KB = {b: f'{b // 1000}kb' for b in BINS}
MSCALE = SETTINGS['mscale']
FIT = SETTINGS['fit']
READS = SETTINGS['reads']
# every option is passed explicitly, so the stages' own defaults do not matter here
READ_OPTS = (f"--mm {READS['mm']} --min-mapq {READS['min_mapq']}" + (' --dedup' if READS['dedup'] else ' --no-dedup'))
NAN_OPT = '--missing-as-nan' if SETTINGS['score']['missing_as_nan'] else '--no-missing-as-nan'
PARK_OPT = '--park' if SETTINGS['park'] else ''      # stages: Park's behaviour where it has no setting
BDATA = SETTINGS['bdata']
QC = SETTINGS['qc']

# ---------------------------------------------------------------- genomes and samples
GENOMES = {g: {'fasta': P(v['fasta']), 'bowtie2_index': P(v['bowtie2_index'])}
           for g, v in config['genomes'].items()}


def default_chroms(fasta):
    """Chromosomes to process when the settings name none (reference.default_chroms)."""
    fai = Path(fasta + '.fai')
    if not fai.exists():
        raise ValueError(f'{fai} not found; run: samtools faidx {fasta}')
    return reference.default_chroms(fai)


if 'sheet' in config:       # sample sheet (condense init); one genome
    CELLS = {config['genome']: {'genome': config['genome'], 'chroms': config.get('chroms')}}
    SAMPLES = sheet.read_simple(P(config['sheet']), config['genome'],
                                nucleosomes=config.get('nucleosomes', False))
else:                       # GEO-style config: samples + titration_dir + cells
    CELLS = {c: ({'genome': v} if isinstance(v, str) else dict(v)) for c, v in config['cells'].items()}
    SAMPLES = sheet.read_config_sheet(config['samples'], config.get('titration_dir', 'titration'), P)
for v in CELLS.values():
    v['chroms'] = list(v.get('chroms') or default_chroms(GENOMES[v['genome']]['fasta']))
for c in sorted(set(SAMPLES['cell']) - set(CELLS)):
    raise ValueError(f'cell {c!r} is in the sample sheet but not under cells: in the config')
S = SAMPLES.reset_index()
SERIES = {s: g.sort_values('tnum') for s, g in S.groupby('series')}
for s, g in SERIES.items():
    assert (g['tnum'] == 0).any(), f'series {s} has no input (tnum 0)'


def cell_of(name):
    return CELLS[SAMPLES.loc[name, 'cell']]


def fasta_of(name):
    return GENOMES[cell_of(name)['genome']]['fasta']


def chroms_of(name):
    return cell_of(name)['chroms']


def input_of(name):
    g = SERIES[SAMPLES.loc[name, 'series']]
    return g.loc[g['tnum'] == 0, 'name'].item()


def points(series):
    """Sample names of a series' titration points (input excluded)."""
    return list(SERIES[series].query('tnum > 0')['name'])


def titration_of(series):
    return SERIES[series].iloc[0]['titration']


ALL_CHROMS = sorted({c for v in CELLS.values() for c in v['chroms']})
DEEP_SERIES = [s for s, g in SERIES.items() if g['deep'].all()]
FIT_KB = KB.get(int(FIT['bin_size']))
FIT_SERIES = [s for s, g in SERIES.items() if FIT_KB and len(g) >= int(FIT['min_tnum'])]

# replicate groups: series that differ only in rep
REP_GROUPS = {}
for s, g in SERIES.items():
    REP_GROUPS.setdefault(g.iloc[0]['group'], []).append(s)
REP_GROUPS = {k: sorted(v) for k, v in REP_GROUPS.items() if len(v) >= 2}
QC_KB = KB[max(BINS)]

wildcard_constraints:
    name='|'.join(map(re.escape, SAMPLES.index)),
    series='|'.join(map(re.escape, SERIES)),
    kb='|'.join(KB.values()),
    chrom='|'.join(map(re.escape, ALL_CHROMS)),
    group='|'.join(map(re.escape, REP_GROUPS)) or 'NONE',


def final_outputs():
    out = [f'tables/{s}_{kb}_score.gtab.gz' for s in SERIES for kb in KB.values()]
    for s in DEEP_SERIES:
        out += [f'tables/{s}_score/{s}_{c}_score.gtab.gz' for c in chroms_of(points(s)[0])]
    out += [f'tables/{s}_{FIT_KB}_4PL.gtab.gz' for s in FIT_SERIES]
    if QC != 'off':
        out.append('qc/report.html')
    return out


rule all:
    input: final_outputs()


MAX_RUNTIME = int(SETTINGS['max_runtime'])     # minutes; default: the time limit of shared/sapphire


def rt(minutes, attempt):
    """Runtime (minutes) for this attempt: doubles on the retry after a timeout, up to MAX_RUNTIME."""
    return min(MAX_RUNTIME, int(minutes * attempt))


def mb(path_list, factor, base):
    """Memory request (MB) from input size: base + factor * input MB."""
    return int(base + factor * sum(Path(p).stat().st_size for p in path_list if Path(p).exists()) / 1e6)

# ---------------------------------------------------------------- alignment
# bowtie2: this environment's (PATH), or the folder of settings `bowtie2` (a version: a conda env under the
# refs folder, installed by `condense reference --bowtie2 VERSION`). Only bowtie2 runs from there.
BT2_DIR = reference.bowtie2_dir(SETTINGS['bowtie2'], config.get('refs'))
if BT2_DIR and not Path(BT2_DIR, 'bowtie2').exists():
    raise ValueError(f"bowtie2 {SETTINGS['bowtie2']}: not in {BT2_DIR}; install it with "
                     f"`condense reference --bowtie2 {SETTINGS['bowtie2']}` (in a Slurm job)")
BT2 = f'PATH={BT2_DIR}:$PATH bowtie2' if BT2_DIR else 'bowtie2'
FASTQ_CHECK = SETTINGS['fastq_check']


rule align:
    # FASTQ check (fastq.py: SRA Lite; Park mode: read names), then bowtie2 end-to-end, paired, reads trimmed
    # to `trim_to` bases; then sorted and indexed
    input:
        r1=lambda w: [P(f) for f in SAMPLES.loc[w.name, 'fastq1'].split(',')],
        r2=lambda w: [P(f) for f in SAMPLES.loc[w.name, 'fastq2'].split(',')],
    output:
        bam='bam/{name}.bam',
        bai='bam/{name}.bam.bai',
    params:
        index=lambda w: GENOMES[cell_of(w.name)['genome']]['bowtie2_index'],
        r1=lambda w, input: ','.join(input.r1),
        r2=lambda w, input: ','.join(input.r2),
    threads: THREADS
    # ~0.8 M pairs per minute with 8 threads; 6 GB
    resources: mem_mb=lambda w, attempt: 9000 * attempt, runtime=lambda w, attempt: rt(48 * 60, attempt)
    log: bt2='logs/align/{name}.log', version='logs/align/{name}.bowtie2_version',
         fastq='logs/align/{name}.fastq_check.json'
    shell:
        f'{CLI} check-fastq --mode {FASTQ_CHECK} -1 {{params.r1}} -2 {{params.r2}} -o {{log.fastq}} && '
        f'{BT2} --version > {{log.version}} && '
        f'{BT2} -p {{threads}} --trim-to {TRIM} -x {{params.index}} -1 {{params.r1}} -2 {{params.r2}} 2> {{log.bt2}} '
        '| samtools sort -@ 2 -m 1G -T bam/{wildcards.name}.tmp -o {output.bam} - && samtools index {output.bam}'

# ---------------------------------------------------------------- binned scores
rule bincount:
    input: bam='bam/{name}.bam', bai='bam/{name}.bam.bai'
    output: 'bin/{name}_{kb}_bin.gtab.gz'
    params:
        fasta=lambda w: fasta_of(w.name),
        chroms=lambda w: ' '.join(chroms_of(w.name)),
        win=lambda w: {v: k for k, v in KB.items()}[w.kb],
    resources:
        mem_mb=lambda w, input, attempt: mb([input.bam], 0.6, 3000) * attempt,
        runtime=lambda w, input, attempt: rt(mb([input.bam], 0.02, 60), attempt),
    shell:
        f'{CLI} bincount --bam {{input.bam}} --fasta {{params.fasta}} --chroms {{params.chroms}} '
        f'--win {{params.win}} {READ_OPTS} {PARK_OPT} -o {{output}}'

rule score_bin:
    input:
        test='bin/{name}_{kb}_bin.gtab.gz',
        control=lambda w: f'bin/{input_of(w.name)}_{w.kb}_bin.gtab.gz',
        tit=lambda w: titration_of(SAMPLES.loc[w.name, 'series']),
    output: 'score/{name}_{kb}_score.gtab.gz'
    params:
        tnum=lambda w: SAMPLES.loc[w.name, 'tnum'],
        chroms=lambda w: ' '.join(chroms_of(w.name)),
    # 1 kb, hg38: 4.4 GB
    resources: mem_mb=lambda w, attempt: (7000 if w.kb == '1kb' else 2000) * attempt, runtime=lambda w, attempt: rt(120, attempt)
    shell:
        f'{CLI} score --test {{input.test}} --control {{input.control}} --titration {{input.tit}} '
        f'--tnum {{params.tnum}} --chroms {{params.chroms}} {NAN_OPT} -o {{output}}'

rule table_bin:
    # one column per titration point (input excluded)
    input: lambda w: [f'score/{n}_{w.kb}_score.gtab.gz' for n in points(w.series)]
    output: 'tables/{series}_{kb}_score.gtab.gz'
    resources: mem_mb=lambda w, attempt: 2000 * attempt, runtime=lambda w, attempt: rt(60, attempt)
    shell: f'{CLI} concat --inputs {{input}} -o {{output}}'

# ---------------------------------------------------------------- per-nucleosome scores (deep series)
rule peaks:
    # nucleosome dyads, called on the input sample only
    input: bam='bam/{name}.bam', bai='bam/{name}.bam.bai'
    output: 'peaks/{name}_{chrom}_peak.gtab.gz'
    resources: mem_mb=lambda w, attempt: 24000 * attempt, runtime=lambda w, attempt: rt(12 * 60, attempt)
    shell: f'{CLI} peaks --bam {{input.bam}} --chrom {{wildcards.chrom}} {READ_OPTS} {PARK_OPT} -o {{output}}'

rule areas:
    # read coverage in a 171 bp window at each dyad; with `bdata: true` also in 171 bp windows every 25 bp
    # (Park's Bdata files: not scored, ~90% of the areas/ folder)
    input:
        bam='bam/{name}.bam', bai='bam/{name}.bam.bai',
        peaks=lambda w: f'peaks/{input_of(w.name)}_{w.chrom}_peak.gtab.gz',
    output:
        ncov='areas/{name}_{chrom}_Ncov.gtab.gz',
        **({'bdata': 'areas/{name}_{chrom}_171win25step_Bdata.gtab.gz'} if BDATA else {}),
    params: fasta=lambda w: fasta_of(w.name)
    resources: mem_mb=lambda w, attempt: 16000 * attempt, runtime=lambda w, attempt: rt(8 * 60, attempt)
    shell:
        f'{CLI} areas --bam {{input.bam}} --fasta {{params.fasta}} --chrom {{wildcards.chrom}} '
        f'--peaks {{input.peaks}} {READ_OPTS} --ncov-out {{output.ncov}}'
        + (' --bdata-out {output.bdata}' if BDATA else '')

rule score_ncov:
    # normalized over all chromosomes together
    input:
        test=lambda w: [f'areas/{w.name}_{c}_Ncov.gtab.gz' for c in chroms_of(w.name)],
        control=lambda w: [f'areas/{input_of(w.name)}_{c}_Ncov.gtab.gz' for c in chroms_of(w.name)],
        tit=lambda w: titration_of(SAMPLES.loc[w.name, 'series']),
    output: touch('score/{name}.ncp_scores.done')
    params:
        tnum=lambda w: SAMPLES.loc[w.name, 'tnum'],
        outs=lambda w: ' '.join(f'score/{w.name}_{c}_score.gtab.gz' for c in chroms_of(w.name)),
    resources: mem_mb=lambda w, attempt: 16000 * attempt, runtime=lambda w, attempt: rt(4 * 60, attempt)
    shell:
        f'{CLI} score --test {{input.test}} --control {{input.control}} --titration {{input.tit}} '
        f'--tnum {{params.tnum}} {NAN_OPT} -o {{params.outs}}'

rule table_ncov:
    # one file per chromosome, one column per titration point
    input: lambda w: [f'score/{n}.ncp_scores.done' for n in points(w.series)]
    output: 'tables/{series}_score/{series}_{chrom}_score.gtab.gz'
    params: files=lambda w: ' '.join(f'score/{n}_{w.chrom}_score.gtab.gz' for n in points(w.series))
    resources: mem_mb=lambda w, attempt: 2000 * attempt, runtime=lambda w, attempt: rt(60, attempt)
    shell: f'{CLI} concat --inputs {{params.files}} -o {{output}}'

# ---------------------------------------------------------------- nucleosome numbers and c-half
rule num_bin:
    input:
        bins='bin/{name}_{kb}_bin.gtab.gz',
        tit=lambda w: titration_of(SAMPLES.loc[w.name, 'series']),
    output: 'num/{name}_{kb}_num.gtab.gz'
    params:
        tnum=lambda w: SAMPLES.loc[w.name, 'tnum'],
        mscale=lambda w: MSCALE.get(SAMPLES.loc[w.name, 'agent'], 1),
        chroms=lambda w: ' '.join(chroms_of(w.name)),
    resources: mem_mb=lambda w, attempt: 2000 * attempt, runtime=lambda w, attempt: rt(60, attempt)
    shell:
        f'{CLI} num --inputs {{input.bins}} --titration {{input.tit}} --tnum {{params.tnum}} '
        f'--mscale {{params.mscale}} --chroms {{params.chroms}} -o {{output}}'

rule table_num:
    input: lambda w: [f'num/{n}_{w.kb}_num.gtab.gz' for n in SERIES[w.series]['name']]
    output: 'tables/{series}_{kb}_num.gtab.gz'
    resources: mem_mb=lambda w, attempt: 2000 * attempt, runtime=lambda w, attempt: rt(60, attempt)
    shell: f'{CLI} concat --inputs {{input}} -o {{output}}'

rule fit:
    # c-half: logistic fit of each bin's surviving nucleosome number across the titration
    input:
        num='tables/{series}_{kb}_num.gtab.gz',
        tit=lambda w: titration_of(w.series),
    output: 'tables/{series}_{kb}_4PL.gtab.gz'
    params: tnums=lambda w: ' '.join(SERIES[w.series]['tnum'].astype(str))
    # 10 kb hg38, ten points: 0.5 GB, ~2.5 h on one core
    resources: mem_mb=lambda w, attempt: 1500 * attempt, runtime=lambda w, attempt: rt(12 * 60, attempt)
    shell:
        f'{CLI} fit --input {{input.num}} --titration {{input.tit}} --tnums {{params.tnums}} '
        f"--model {FIT['model']} --method {FIT['method']} --min-rsq {FIT['min_rsq']} -o {{output}}"

# ---------------------------------------------------------------- quality control
VERBOSE = '--verbose' if QC == 'verbose' else ''

rule qc_sample:
    # alignment summary, read filters, fragment lengths
    input: bam='bam/{name}.bam', log='logs/align/{name}.log'
    output: 'qc/samples/{name}.json'
    threads: 4
    resources: mem_mb=lambda w, attempt: (8000 if VERBOSE else 2000) * attempt, runtime=lambda w, attempt: rt(4 * 60, attempt)
    shell:
        f"{CLI} qc-sample --bam {{input.bam}} --bowtie2-log {{input.log}} --mm {READS['mm']} "
        f"--min-mapq {READS['min_mapq']} --threads {{threads}} {VERBOSE} -o {{output}}"

rule qc_series:
    input:
        samples=lambda w: [f'qc/samples/{n}.json' for n in SERIES[w.series]['name']],
        bins=lambda w: [f'bin/{n}_{QC_KB}_bin.gtab.gz' for n in SERIES[w.series]['name']],
        table=lambda w: f'tables/{w.series}_{QC_KB}_score.gtab.gz',
        tit=lambda w: titration_of(w.series),
        fit=lambda w: [f'tables/{w.series}_{FIT_KB}_4PL.gtab.gz'] if w.series in FIT_SERIES else [],
        peaks=lambda w: ([f'peaks/{SERIES[w.series].iloc[0]["name"]}_{c}_peak.gtab.gz'
                          for c in chroms_of(SERIES[w.series].iloc[0]['name'])]
                         if w.series in DEEP_SERIES else []),
    output: json='qc/series/{series}.json', png='qc/series/{series}.png'
    params:
        fit=lambda w, input: f'--fit {input.fit[0]}' if input.fit else '',
        peaks=lambda w, input: f'--peaks {" ".join(input.peaks)}' if input.peaks else '',
        fasta=lambda w: fasta_of(SERIES[w.series].iloc[0]['name']),
    resources: mem_mb=lambda w, attempt: 4000 * attempt, runtime=lambda w, attempt: rt(60, attempt)
    shell:
        f'{CLI} qc-series --series {{wildcards.series}} --samples {{input.samples}} --bins {{input.bins}} '
        f'--table {{input.table}} --titration {{input.tit}} {{params.fit}} {{params.peaks}} '
        f'--fasta {{params.fasta}} {VERBOSE} -o {{output.json}} --png {{output.png}}'

rule qc_replicates:
    input: lambda w: [f'tables/{s}_{kb}_score.gtab.gz' for kb in KB.values() for s in REP_GROUPS[w.group]]
    output: json='qc/replicates/{group}.json', png='qc/replicates/{group}.png'
    params:
        args=lambda w: ' '.join(f'--tables {kb} ' + ' '.join(f'tables/{s}_{kb}_score.gtab.gz' for s in REP_GROUPS[w.group])
                                for kb in KB.values())
    resources: mem_mb=lambda w, attempt: 8000 * attempt, runtime=lambda w, attempt: rt(60, attempt)
    shell: f'{CLI} qc-replicates --group {{wildcards.group}} {{params.args}} -o {{output.json}} --png {{output.png}}'

rule qc_report:
    input:
        samples=[f'qc/samples/{n}.json' for n in SAMPLES.index],
        series=[f'qc/series/{s}.json' for s in SERIES],
        reps=[f'qc/replicates/{g}.json' for g in REP_GROUPS],
    output: html='qc/report.html', summary='qc/summary.tsv', flags='qc/flags.tsv'
    params: thresholds=lambda w: ' '.join(f'{k}={v}' for k, v in SETTINGS['qc_thresholds'].items())
    resources: mem_mb=1000, runtime=lambda w, attempt: rt(10, attempt)
    shell:
        f'{CLI} qc-report --samples {{input.samples}} --series {{input.series}} '
        f'--replicates {{input.reps}} --thresholds {{params.thresholds}} --outdir qc'
